{
  "builds": [
    { "src": "api/send-telegram.js", "use": "@vercel/node" }
  ],
  "routes": [
    {"src": "/api/send-telegram",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "api/send-telegram.js"
    }
  ]
}

}
